# CaseForge — Environment Variables
# Copy this to .env.local and fill in all values before running.
# NEVER commit .env.local to git.

# ── Supabase ─────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Groq (AI + Transcription) ────────────────────────────────
# Sign up free at: https://console.groq.com
# Used for: question generation, transcript cleaning, case study synthesis,
#           and audio transcription (Whisper). Generous free tier.
GROQ_API_KEY=gsk_...
# IMPORTANT: enable the Whisper speech-to-text models for your project at
# https://console.groq.com/settings/project/limits — if they are blocked,
# every transcription fails with a 403.
# Optional: override the text model (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile
# Optional: override the transcription model (default: whisper-large-v3)
# GROQ_WHISPER_MODEL=whisper-large-v3

# ── Resend (Email) ────────────────────────────────────────────
# Found in: https://resend.com/api-keys
# Optional — app works without it; emails are silently skipped.
RESEND_API_KEY=re_...
# The email address you've verified with Resend to send FROM
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── App URL ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production (update after deploying):
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
